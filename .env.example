# ── PostgreSQL ────────────────────────────────────────────────
# When running locally (go run ./cmd/api): point at your local Postgres.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketplace_db
DB_USER=postgres
DB_PASSWORD=marketplace123

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=super-secret-jwt-key-change-in-production

# ── Server ───────────────────────────────────────────────────
SERVER_PORT=8080

# ── Docker Compose only (host port mappings) ─────────────────
# These do not affect the running Go app; they only map container
# ports onto your host machine.
API_PORT=8080
DB_EXPOSE_PORT=5433